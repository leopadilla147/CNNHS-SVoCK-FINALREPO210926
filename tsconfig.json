{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"],
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}